generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/construct-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CONSTRUCT_DATABASE_URL")
  schemas  = ["construct"]
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@schema("construct")
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER

  @@schema("construct")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@schema("construct")
}

// New invites go through Membership.status/invitedEmail (below), mirroring
// Pets' plain email-reconciliation pattern — no token/link. This enum and
// the Invitation model stay only for already-emailed accept links from
// before this change; see construct-team.actions.ts.
enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED

  @@schema("construct")
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
  REMOVED

  @@schema("construct")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED

  @@schema("construct")
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER

  @@schema("construct")
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED

  @@schema("construct")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED

  @@schema("construct")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(PENDING)
  // Construct's own local source of truth for gating (mirrors Pets'
  // tenants.plan_code/trial_ends_at) — set by the signup trigger, kept
  // current by the self-serve checkout webhook and the trial-expiry cron,
  // read live on every request by getConstructCommercialAccess(). Also
  // pushed to the shared control schema for the admin dashboard, but that
  // copy is not what this app itself reads.
  planCode    String             @default("TRIAL") @map("plan_code")
  trialEndsAt DateTime?          @map("trial_ends_at")
  // IANA zone (e.g. "Asia/Kolkata"), used for every date/time boundary a
  // human reads or types against — follow-up due dates and shortcuts,
  // "today"/"overdue" cutoffs, list labels. Defaulted to India's zone
  // (this product's primary market; matches priceCurrency's "INR"
  // default on Proposal) rather than silently using the server's local
  // time. Validated against Intl.supportedValuesOf("timeZone") server-side
  // — see lib/followups/timezone.ts's isValidTimezone().
  timezone    String             @default("Asia/Kolkata")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  plan            Plan             @relation(fields: [planCode], references: [code])
  subscription    Subscription?
  memberships     Membership[]
  invitations     Invitation[]
  domains         Domain[]
  settings        SiteSettings?
  publication     SitePublication?
  projects        Project[]
  projectTaxonomies ProjectTaxonomy[]
  whyChooseUsHighlights WhyChooseUsHighlight[]
  media           Media[]
  mediaFolders    MediaFolder[]
  galleries       Gallery[]
  services        Service[]
  teamMembers     TeamMember[]
  clients         Client[]
  testimonials    Testimonial[]
  faqs            Faq[]
  messages        ContactMessage[]
  serviceEnquiryQuestions ServiceEnquiryQuestion[]
  seoSettings     SeoSettings?
  seoPages        SeoPage[]
  navigationItems NavigationItem[]
  auditLogs       AuditLog[]
  proposals               Proposal[]
  proposalRevisions       ProposalRevision[]
  proposalPortfolioItems  ProposalPortfolioItem[]
  proposalTestimonialItems ProposalTestimonialItem[]
  proposalResponses       ProposalResponse[]
  followUps               FollowUp[]
  progressProjects        ProgressProject[]
  progressMilestones      ProgressMilestone[]
  progressUpdates         ProgressUpdate[]
  progressPhotos          ProgressPhoto[]
  progressSnapshots       ProgressSnapshot[]

  @@map("organizations")
  @@schema("construct")
}

// Construct's own local plan catalog — mirrors menagerie.plans. Limits
// are enforced from here (construct-subscription.service.ts), not from
// the shared control.plan_entitlements — each product's local plan table
// is its own enforcement source, kept in sync with control.plans (the
// admin-editable copy) by whoever edits /admin/plans on shaoor-ai.com.
// Deliberately thin — mirrors TuiTrak's tuitrakweb.plans design (the
// reference implementation, C:\Projects\TuiTrakWeb, see its
// 0039_control_plans_live_read.sql): only what has no equivalent in the
// shared shaoor-ai.com control plane's own control.plans lives here.
// Pricing/marketing fields (price, currency, billing interval,
// feature_lines, trial length) are read live from control.plans instead —
// see lib/services/construct-plan-catalog.service.ts — so an edit made in
// the shared /admin/plans UI takes effect immediately, with no deploy.
// `name` is the one exception, kept local (not dropped, unlike TuiTrak's
// version): lib/control/construct-subscription.service.ts's
// getConstructCommercialAccess() reads it for fast, local-only gating
// error messages, and that function is explicitly local-state-only by
// design — not part of this live-read migration.
model Plan {
  code            String   @id
  name            String
  // No isTrial flag, and no dedicated "TRIAL" row (removed 2026-09-23): a
  // trial now runs directly on the real top-tier plan (whichever
  // control.plans flags is_top_tier — see lib/auth/provisioning.ts and
  // lib/services/construct-plan-catalog.service.ts's getConstructTopTierTrial()),
  // mirroring TuiTrak's model. subscriptions.status ("TRIALING" vs
  // "ACTIVE") is what distinguishes a trial from a paid subscription on
  // the same plan code, not the plan code itself.
  isFreeForever   Boolean  @default(false) @map("is_free_forever")
  seatLimit       Int?     @map("seat_limit")
  projectLimit    Int?     @map("project_limit")
  mediaLimit      Int?     @map("media_limit")
  // Pre-created in the Razorpay dashboard, same as Pets' equivalent
  // columns — NULL means this plan isn't purchasable through self-serve
  // checkout yet (see app/api/razorpay/subscription's guard).
  razorpayPlanIdMonthly String? @map("razorpay_plan_id_monthly")
  razorpayPlanIdAnnual  String? @map("razorpay_plan_id_annual")
  createdAt       DateTime @default(now()) @map("created_at")

  organizations Organization[]

  @@map("plans")
  @@schema("construct")
}

// Billing/payment status only — "which plan" lives on Organization.planCode
// (matches menagerie.subscriptions carrying no plan_code of its own
// either). Absence of a row means "still on the initial trial, or on the
// free tier with nothing ever billed" — same convention as Pets.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  status                 SubscriptionStatus
  currentPeriodEnd       DateTime?          @map("current_period_end")
  razorpayCustomerId     String?            @map("razorpay_customer_id")
  razorpaySubscriptionId String?            @map("razorpay_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
  @@schema("construct")
}

// Records a failed best-effort control-plane sync (e.g. from the signup
// trigger) for manual/cron reconciliation — a sync failure must never
// block the operation that triggered it. Mirrors the reasoning behind
// lib/control-sync.ts's non-throwing behavior on the Pets side.
model ControlSyncFailure {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("control_sync_failures")
  @@schema("construct")
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  invitationsSent Invitation[]      @relation("InvitationsSent")
  auditLogs       AuditLog[]
  publications    SitePublication[] @relation("PublishedBy")
  proposalsCreated   Proposal[]         @relation("ProposalCreatedBy")
  proposalsPublished Proposal[]         @relation("ProposalPublishedBy")
  proposalRevisionsPublished ProposalRevision[] @relation("ProposalRevisionPublishedBy")
  followUpsAssigned  FollowUp[]         @relation("FollowUpAssignee")
  followUpsCreated   FollowUp[]         @relation("FollowUpCreatedBy")
  followUpsCompleted FollowUp[]         @relation("FollowUpCompletedBy")
  progressProjectsCreated   ProgressProject[]  @relation("ProgressProjectCreatedBy")
  progressUpdatesCreated    ProgressUpdate[]   @relation("ProgressUpdateCreatedBy")
  progressUpdatesPublished  ProgressUpdate[]   @relation("ProgressUpdatePublishedBy")
  progressUpdatesWithdrawn  ProgressUpdate[]   @relation("ProgressUpdateWithdrawnBy")
  progressPhotosCreated     ProgressPhoto[]    @relation("ProgressPhotoCreatedBy")
  progressSnapshotsPublished ProgressSnapshot[] @relation("ProgressSnapshotPublishedBy")

  @@map("users")
  @@schema("construct")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  // Nullable — an invited-but-not-yet-signed-up member has no user yet
  // (mirrors menagerie.memberships.user_id). Filled in and status flips
  // to ACTIVE when invitedEmail matches a new or existing signup.
  userId         String?          @map("user_id") @db.Uuid
  invitedEmail   String?          @map("invited_email")
  status         MembershipStatus @default(ACTIVE)
  role           MembershipRole   @default(EDITOR)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial unique index on (organization_id, invited_email) WHERE
  // user_id IS NULL is created via raw SQL in the migration — Prisma's
  // schema DSL doesn't support a WHERE clause on @@unique.
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, invitedEmail])
  @@map("memberships")
  @@schema("construct")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  role           MembershipRole
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  invitedById    String           @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([email])
  @@map("invitations")
  @@schema("construct")
}

model Domain {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  hostname          String       @unique
  status            DomainStatus @default(PENDING)
  verificationToken String       @unique @map("verification_token")
  isPrimary         Boolean      @default(false) @map("is_primary")
  verifiedAt        DateTime?    @map("verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("domains")
  @@schema("construct")
}

model SitePublication {
  organizationId String            @id @map("organization_id") @db.Uuid
  status         PublicationStatus @default(DRAFT)
  publishedAt    DateTime?         @map("published_at")
  publishedById  String?           @map("published_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedBy  User?        @relation("PublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@map("site_publications")
  @@schema("construct")
}

model SiteSettings {
  organizationId     String   @id @map("organization_id") @db.Uuid
  companyName        String   @map("company_name")
  tagline            String
  description        String
  logoUrl            String?  @map("logo_url")
  faviconUrl         String?  @map("favicon_url")
  phone              String
  email              String
  website            String?
  addressLine1       String   @map("address_line_1")
  addressLine2       String?  @map("address_line_2")
  city               String
  state              String?
  country            String
  postalCode         String?  @map("postal_code")
  facebook           String?
  instagram          String?
  linkedin           String?
  youtube            String?
  twitter            String?
  heroTitle          String   @map("hero_title")
  heroSubtitle       String   @map("hero_subtitle")
  heroImageUrl       String?  @map("hero_image_url")
  ctaTitle           String   @map("cta_title")
  ctaSubtitle        String   @map("cta_subtitle")
  ctaButtonText      String   @map("cta_button_text")
  ctaButtonLink      String   @map("cta_button_link")
  projectsCompleted  Int      @default(0) @map("projects_completed")
  clientsServed      Int      @default(0) @map("clients_served")
  yearsExperience    Int      @default(0) @map("years_experience")
  employees          Int      @default(0)
  whatsApp           String?  @map("whats_app")
  googleMapsUrl      String?  @map("google_maps_url")
  aboutTitle         String?  @map("about_title")
  aboutSubtitle      String?  @map("about_subtitle")
  aboutStory         String?  @map("about_story")
  missionTitle       String?  @map("mission_title")
  missionDescription String?  @map("mission_description")
  visionTitle        String?  @map("vision_title")
  visionDescription  String?  @map("vision_description")
  aboutImageUrl      String?  @map("about_image_url")
  whyChooseUsTitle    String  @default("Building with Confidence") @map("why_choose_us_title")
  whyChooseUsSubtitle String  @default("Every project is backed by professional expertise, disciplined execution, and a commitment to delivering exceptional results.") @map("why_choose_us_subtitle")
  // Per-tenant website theme, editable from /dashboard/settings. NULL means
  // "use Shaoor's own default brand colors" (#094136 / #7D9D76) — a tenant
  // who never opens the branding section sees no change. Validated as
  // #rrggbb hex server-side before saving; applied to the public website
  // only (not the dashboard/admin/auth chrome, which stays on-brand for
  // Shaoor regardless of what a tenant picks for their own site).
  themePrimaryColor  String?  @map("theme_primary_color")
  themeAccentColor   String?  @map("theme_accent_color")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("site_settings")
  @@schema("construct")
}

// The four icon+title+description cards in the home page's "Why Choose
// Us" section — icon is a key into a small curated registry (see
// lib/website-icons.ts), not a free-typed icon name.
model WhyChooseUsHighlight {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  icon           String
  title          String
  description    String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sortOrder])
  @@map("why_choose_us_highlights")
  @@schema("construct")
}

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  slug           String
  title          String
  category       String
  status         String
  client         String
  location       String
  year           Int
  duration       String
  budget         String
  area           String
  coverImageUrl  String?  @map("cover_image_url")
  description    String
  featured       Boolean  @default(false)
  // Show/Hide, independent of Featured (which only controls homepage
  // prominence) — a hidden project never appears on the public site at
  // all, so it can't sensibly stay featured; the toggle action clears
  // featured whenever this goes false.
  isActive       Boolean  @default(true) @map("is_active")
  // True only for the 2 starter projects created by the default-content
  // seeder (org creation, or a re-seed of an emptied list) — never set by
  // the normal project form. Drives the "this is sample content" dashboard
  // banner; saveConstructProjectAction clears it on the first real edit,
  // so the banner fades out per-org as samples get customized or deleted
  // rather than needing its own dismiss state.
  isSample       Boolean  @default(false) @map("is_sample")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String?  @map("seo_keywords")
  canonicalUrl   String?  @map("canonical_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  highlights   ProjectHighlight[]
  galleryItems ProjectGalleryItem[]
  proposalPortfolioItems ProposalPortfolioItem[]
  progressProjects ProgressProject[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, featured])
  @@index([organizationId, isActive])
  @@map("projects")
  @@schema("construct")
}

model ProjectHighlight {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  projectId      String @map("project_id") @db.Uuid
  text           String
  sortOrder      Int    @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@map("project_highlights")
  @@schema("construct")
}

model ProjectGalleryItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  projectId      String  @map("project_id") @db.Uuid
  imageUrl       String  @map("image_url")
  altText        String? @map("alt_text")
  sortOrder      Int     @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@map("project_gallery_items")
  @@schema("construct")
}

// Tenant-managed picklists for Project.category and Project.status,
// maintained from the Content page — one kind-discriminated table
// rather than two near-identical ones, mirroring how Content already
// unifies team/client/testimonial/faq under one save action.
model ProjectTaxonomy {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kind           String
  value          String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, value])
  @@index([organizationId, kind, sortOrder])
  @@map("project_taxonomies")
  @@schema("construct")
}

model Media {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  fileName       String    @map("file_name")
  originalName   String    @map("original_name")
  storagePath    String    @map("storage_path")
  url            String
  thumbnailUrl   String?   @map("thumbnail_url")
  altText        String?   @map("alt_text")
  title          String?
  description    String?
  folder         String?
  mimeType       String    @map("mime_type")
  extension      String
  fileSize       Int       @map("file_size")
  width          Int?
  height         Int?
  type           MediaType
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  folderId String? @map("folder_id") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folderRef    MediaFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  galleryItems GalleryItem[]

  @@unique([organizationId, storagePath])
  @@index([organizationId, folder])
  @@index([organizationId, folderId])
  @@map("media")
  @@schema("construct")
}

// A real folder tree, distinct from Media.folder (a flat legacy string —
// kept for backward compatibility with rows uploaded before this model
// existed). Lets a folder exist — and be created or deleted — with no
// media in it, which a value merely derived from existing Media rows
// never could.
model MediaFolder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  parentId       String?  @map("parent_id") @db.Uuid
  // Materialized full path (e.g. "library/logos") — cheap display and
  // lookup without walking the parent chain on every render.
  path           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       MediaFolder?  @relation("MediaFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     MediaFolder[] @relation("MediaFolderChildren")
  media        Media[]

  @@unique([organizationId, path])
  @@index([organizationId, parentId])
  @@map("media_folders")
  @@schema("construct")
}

model Gallery {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  slug           String
  description    String?
  coverImageUrl  String?  @map("cover_image_url")
  featured       Boolean  @default(false)
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        GalleryItem[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("galleries")
  @@schema("construct")
}

model GalleryItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  galleryId      String   @map("gallery_id") @db.Uuid
  mediaId        String   @map("media_id") @db.Uuid
  caption        String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([galleryId, mediaId])
  @@index([organizationId, galleryId])
  @@map("gallery_items")
  @@schema("construct")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  title            String
  slug             String
  shortDescription String   @map("short_description")
  description      String
  imageUrl         String?  @map("image_url")
  icon             String?
  displayOrder     Int      @default(0) @map("display_order")
  isActive         Boolean  @default(true) @map("is_active")
  // Same sample-content flag as Project.isSample — see that field's
  // comment. Set true only by the default-services seeder, cleared by
  // saveConstructServiceAction on the first real edit.
  isSample         Boolean  @default(false) @map("is_sample")
  seoTitle         String?  @map("seo_title")
  seoDescription   String?  @map("seo_description")
  seoKeywords      String?  @map("seo_keywords")
  canonicalUrl     String?  @map("canonical_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subServices  SubService[]
  enquiryQuestions ServiceEnquiryQuestion[]
  enquiries    ContactMessage[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("services")
  @@schema("construct")
}

// A single-column bullet list attached to a Service — mirrors
// ProjectHighlight exactly (same shape, same replace-all-on-save
// convention in saveConstructServiceAction). Capped at 10 per service,
// enforced in the action rather than here.
model SubService {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid
  text           String
  sortOrder      Int    @default(0) @map("sort_order")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([organizationId, serviceId])
  @@map("sub_services")
  @@schema("construct")
}

// One tenant-configured question on a service's public enquiry form.
// `options` is a JSON string array, only meaningful for single_select /
