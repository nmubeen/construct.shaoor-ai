// --- Project Proposals -----------------------------------------------
// A personalised, branded proposal an owner prepares from an existing
// enquiry and shares with the customer via a private, unguessable link.
// Gated behind the PROJECT_PROPOSALS boolean entitlement (see
// lib/control/construct-subscription.service.ts's
// enforceConstructBooleanEntitlement, same mechanism CUSTOM_DOMAIN
// already uses) — enforced server-side on create/edit/publish, never by
// hiding a button alone.
//
// Lifecycle is deliberately 3 states, matching the product spec exactly:
// DRAFT (editable, never externally accessible) -> PUBLISHED (a
// ProposalRevision snapshot exists and is what the public link actually
// serves) -> REVOKED (link stops resolving). PUBLISHED -> REVOKED ->
// PUBLISHED again is allowed (republish reuses the same token). There is
// no separate "Approved" status: approving and publishing are the same
// server-enforced transition (approveAndPublishConstructProposalAction,
// Owner/Admin only) — editing a draft can never by itself make it
// externally accessible, since the public route only ever reads the
// latest ProposalRevision, never Proposal's own live-editable fields.
enum ProposalStatus {
  DRAFT
  PUBLISHED
  REVOKED

  @@schema("construct")
}

enum ProposalPriceMode {
  DISCUSS
  FIXED
  RANGE

  @@schema("construct")
}

enum ProposalResponseType {
  DISCUSS
  SITE_VISIT

  @@schema("construct")
}

model Proposal {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  enquiryId      String         @map("enquiry_id") @db.Uuid
  status         ProposalStatus @default(DRAFT)

  // Short, human-shown identifier (e.g. "PRP-0007"), distinct from id.
  reference String

  // --- Customer-facing content (the live, editable working copy) ---
  // Publishing snapshots these fields (plus branding, portfolio and
  // testimonial selections at that moment) into a new ProposalRevision.
  // Editing these after publish only changes the working copy; the
  // public link keeps serving the last published revision until
  // re-approved and republished.
  title               String
  introduction        String  @default("")
  // Deterministic plain-language summary generated from the enquiry's
  // stored answers (lib/services/construct-proposal-draft.service.ts) —
  // editable afterward, never regenerated silently over a staff edit.
  requirementsSummary String  @default("") @map("requirements_summary")
  scopeOfWork         String  @default("") @map("scope_of_work")
  exclusions          String  @default("")
  assumptions         String  @default("")
  closingMessage      String  @default("") @map("closing_message")
  indicativeTimeline  String? @map("indicative_timeline")

  // --- Pricing: explicit mode, never auto-generated (see price mode
  // comment below) — DISCUSS carries no amount, FIXED uses
  // priceAmountMinor, RANGE uses the min/max pair. Amounts are integer
  // minor units (paise for INR), the only money-representation
  // precedent anywhere in this system (control.plans.price_amount) —
  // deliberately not a float, to avoid rounding drift.
  priceMode           ProposalPriceMode @default(DISCUSS) @map("price_mode")
  priceCurrency       String            @default("INR") @map("price_currency")
  priceAmountMinor    Int?              @map("price_amount_minor")
  priceMinAmountMinor Int?              @map("price_min_amount_minor")
  priceMaxAmountMinor Int?              @map("price_max_amount_minor")
  pricingBasis        String?           @map("pricing_basis")
  taxNote              String?          @map("tax_note")

  // Staff-only — never included in a ProposalRevision snapshot, never
  // rendered on the public page.
  internalNotes String? @map("internal_notes")

  expiresAt DateTime? @map("expires_at")

  // The raw bearer token (high-entropy, base64url — see
  // lib/proposal-token.ts), stored directly rather than hashed:  unlike
  // e.g. Invitation.tokenHash (a one-time, emailed-and-forgotten accept
  // link), the dashboard's own "Copy link" action needs to redisplay
  // this indefinitely, which a one-way hash would make impossible after
  // creation. The real protections are the token's entropy, HTTPS-only
  // transmission and never logging it (see the public route's own
  // comments) — same bearer-link trust model as a Calendly/Docusign
  // share link, not a password-reset-style secret. One token per
  // proposal, reused across republished revisions (see lifecycle
  // comment above) — a leaked link is revoked by status, not by
  // rotating the token.
  token String @unique

  currentRevisionNumber Int @default(0) @map("current_revision_number")

  // Aggregate view activity — see the "excludes owner previews" comment
  // on the public route: the dashboard preview never touches that route,
  // so nothing here needs to distinguish owner vs customer after the
  // fact. firstOpenedAt/lastOpenedAt/openCount only advance from actual
  // public-link requests; lastOpenedAt-based deduping (see
  // recordConstructProposalView) absorbs refreshes within a short
  // window rather than counting each as a new open.
  firstOpenedAt DateTime? @map("first_opened_at")
  lastOpenedAt  DateTime? @map("last_opened_at")
  openCount     Int       @default(0) @map("open_count")

  createdById   String?   @map("created_by_id") @db.Uuid
  publishedById String?   @map("published_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  publishedAt   DateTime? @map("published_at")
  revokedAt     DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiry       ContactMessage            @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdBy     User?                     @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy   User?                     @relation("ProposalPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  portfolioItems     ProposalPortfolioItem[]
  testimonialItems   ProposalTestimonialItem[]
  revisions          ProposalRevision[]
  responses          ProposalResponse[]
  followUps          FollowUp[]
  progressProjects   ProgressProject[]

  // Enforces "at most one open draft per enquiry" at the database level
  // (partial unique index — added via raw SQL in the migration, Prisma's
  // schema DSL has no WHERE clause on @@unique) so a double-click or a
  // retried request can't create a duplicate draft; reuse the existing
  // one instead. Multiple non-draft (published/revoked) historical
  // proposals per enquiry remain allowed.
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, enquiryId])
  @@map("proposals")
  @@schema("construct")
}

// One immutable, fully self-contained snapshot per published/republished
// version — everything the public page renders comes from `snapshot`
// (Json), never a live join, so a later edit to the org's branding,
// services or the working-copy Proposal fields can never silently change
// what a customer already has a link to. See
// lib/services/construct-proposal-snapshot.service.ts for the exact
// shape written into `snapshot`.
model ProposalRevision {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  proposalId     String   @map("proposal_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  snapshot       Json
  publishedAt    DateTime @default(now()) @map("published_at")
  publishedById  String?  @map("published_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  publishedBy User?    @relation("ProposalRevisionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([proposalId, revisionNumber])
  @@index([organizationId, proposalId])
  @@map("proposal_revisions")
  @@schema("construct")
}

// Draft-time portfolio selection — a real FK to Project (not an id
// embedded in JSON) so organization ownership is a plain join check, not
// app-level trust; frozen into the revision snapshot at publish time, so
// removing or editing the project afterward doesn't change an already
// published proposal.
model ProposalPortfolioItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  proposalId     String  @map("proposal_id") @db.Uuid
  projectId      String  @map("project_id") @db.Uuid
  // Short, human-facing suggestion reason ("Same service — Interior &
  // Fit-Out Works"); null for a manually added project.
  reason    String?
  sortOrder Int     @default(0) @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([proposalId, projectId])
  @@index([organizationId, proposalId])
  @@map("proposal_portfolio_items")
  @@schema("construct")
}

model ProposalTestimonialItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  proposalId     String @map("proposal_id") @db.Uuid
  testimonialId  String @map("testimonial_id") @db.Uuid
  sortOrder      Int    @default(0) @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal    Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([proposalId, testimonialId])
  @@index([organizationId, proposalId])
  @@map("proposal_testimonial_items")
  @@schema("construct")
}

// A customer's "Discuss this proposal" / "Request a site visit" click
// through the bearer link — an unverified request, not confirmed
// identity or contractual acceptance (see the public response action's
// own comment). revisionNumber records which version they were looking
// at when they responded.
model ProposalResponse {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  proposalId     String               @map("proposal_id") @db.Uuid
  revisionNumber Int                  @map("revision_number")
  type           ProposalResponseType
  message        String?
  preferredDate  DateTime?            @map("preferred_date")
  preferredTime  String?              @map("preferred_time")
  // Hashed, not raw — enough to rate-limit/de-duplicate abuse from one
  // source without storing a customer's raw IP.
  requesterIpHash String?             @map("requester_ip_hash")
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([organizationId, proposalId])
  @@map("proposal_responses")
  @@schema("construct")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  module         String
  action         String
  recordId       String?  @map("record_id")
  title          String
  details        Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, module])
  @@map("audit_logs")
  @@schema("construct")
}

// --- Private customer project progress --------------------------------
// A private construction-delivery project, distinct from a public
// portfolio Project (marketing content) — a company must be able to
// track customer work without ever publishing it on its website. May
// optionally link to the enquiry/proposal it came from and/or an
// existing public portfolio Project purely for staff traceability;
// linking never copies or exposes anything from those records into the
// customer-facing payload (see ProgressSnapshot). Gated behind the
// PRIVATE_PROJECT_PROGRESS boolean entitlement — enforced server-side
// on create/edit/upload/publish/issue-access, never by hiding a button
// alone (same mechanism as PROJECT_PROPOSALS/CUSTOM_DOMAIN). Losing the
// entitlement blocks new work but never deletes data, and never
// silently re-enables a link a staff member explicitly revoked — see
// lib/services/construct-progress-public.service.ts's own comment.
enum ProgressLifecycle {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED

  @@schema("construct")
}

enum ProgressMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@schema("construct")
}

// DRAFT -> PUBLISHED (visible to the customer) -> WITHDRAWN (pulled
// back, history kept — distinct from DRAFT so "was once published,
// then withdrawn" stays distinguishable from "never published").
// Owners/Admins can edit a PUBLISHED update in place (unlike a
// Proposal's frozen revisions) — see construct-progress.actions.ts's
// own comment for why that doesn't need snapshot/revision treatment
// the way the project summary + milestones do.
enum ProgressUpdateStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN

  @@schema("construct")
}

model ProgressProject {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  title        String
  customerName String @map("customer_name")

  // Private — never read into ProgressSnapshot or the public payload.
  customerEmail String? @map("customer_email")
  customerPhone String? @map("customer_phone")

  location                String?
  // Off by default: a site address is exactly the kind of detail that
  // must be explicitly opted in before it can appear on a page anyone
  // holding the link can open.
  locationCustomerVisible Boolean @default(false) @map("location_customer_visible")

  customerSummary String  @default("") @map("customer_summary")
  // Staff-only, same treatment as Proposal.internalNotes.
  internalNotes   String? @map("internal_notes")

  // Optional cross-links, all nullable/SetNull — purely staff-side
  // traceability, never a data source for the public payload.
  enquiryId          String? @map("enquiry_id") @db.Uuid
  proposalId         String? @map("proposal_id") @db.Uuid
  portfolioProjectId String? @map("portfolio_project_id") @db.Uuid

  // Presented to the customer as planned dates, not guarantees — see
  // ProgressContentView's copy.
  plannedStartDate     DateTime? @map("planned_start_date")
  targetCompletionDate DateTime? @map("target_completion_date")

  lifecycle           ProgressLifecycle @default(PLANNED)
  currentStage        String?           @map("current_stage")
  nextPlannedActivity String?           @map("next_planned_activity")

  // Working-copy fields above can be edited by any non-Viewer; only an
  // explicit "Publish changes" (Owner/Admin) snapshots them here into
  // customer visibility — see ProgressSnapshot. currentRevisionNumber
  // mirrors Proposal.currentRevisionNumber exactly.
  currentRevisionNumber Int @default(0) @map("current_revision_number")

  // Bearer-link access. Hash-only (unlike Proposal.token) — see
  // lib/progress-token.ts's comment: these are private construction
  // photographs, not a sales pitch that needs indefinite "Copy link"
  // redisplay, so the raw token is shown to staff exactly once, right
  // after generate/rotate, then forgotten (same trust model as
  // Invitation.tokenHash). Revoking sets this back to NULL — a link
  // that was NULLed by an explicit revoke never resolves again, even
  // after PRIVATE_PROJECT_PROGRESS is restored (see the public
  // resolver's own comment); generating a new one is a deliberate,
  // separate staff action.
  accessTokenHash String?   @unique @map("access_token_hash")
  accessExpiresAt DateTime? @map("access_expires_at")
  accessCreatedAt DateTime? @map("access_created_at")
  // Set by an explicit revoke, cleared by generate/rotate (which also
  // replace accessTokenHash itself). Kept as its own field, distinct
  // from simply nulling accessTokenHash, purely so the public resolver
  // and the dashboard can tell "revoked" apart from "never generated" —
  // functionally either way the link stops resolving; this only
  // affects which honest, generic message is shown.
  accessRevokedAt DateTime? @map("access_revoked_at")

  firstOpenedAt DateTime? @map("first_opened_at")
  lastOpenedAt  DateTime? @map("last_opened_at")
  openCount     Int       @default(0) @map("open_count")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiry          ContactMessage? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  proposal         Proposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  portfolioProject Project?        @relation(fields: [portfolioProjectId], references: [id], onDelete: SetNull)
  createdBy        User?           @relation("ProgressProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  milestones ProgressMilestone[]
  updates    ProgressUpdate[]
  snapshots  ProgressSnapshot[]

  @@index([organizationId, lifecycle, updatedAt])
  @@map("progress_projects")
  @@schema("construct")
}

model ProgressMilestone {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  projectId      String @map("project_id") @db.Uuid

  title         String
  description   String?
  plannedDate   DateTime?               @map("planned_date")
  status        ProgressMilestoneStatus @default(NOT_STARTED)
  completedDate DateTime?               @map("completed_date")
  sortOrder     Int                     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      ProgressProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updates      ProgressUpdate[]

  @@index([organizationId, projectId, sortOrder])
  @@map("progress_milestones")
  @@schema("construct")
}

model ProgressUpdate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  projectId      String @map("project_id") @db.Uuid

  updateDate          DateTime @map("update_date")
  title               String
  workCompleted       String   @default("") @map("work_completed")
  workInProgress      String   @default("") @map("work_in_progress")
  nextPlannedActivity String   @default("") @map("next_planned_activity")
  // Customer-facing, optional — an honest note about a delay/issue, not
  // an internal note (internalNotes lives on ProgressProject only).
  issueNote           String?  @map("issue_note")

  milestoneId String? @map("milestone_id") @db.Uuid

  status ProgressUpdateStatus @default(DRAFT)

  createdById   String?   @map("created_by_id") @db.Uuid
  publishedById String?   @map("published_by_id") @db.Uuid
  publishedAt   DateTime? @map("published_at")
  withdrawnById String?   @map("withdrawn_by_id") @db.Uuid
  withdrawnAt   DateTime? @map("withdrawn_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      ProgressProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    ProgressMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("ProgressUpdateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy  User?              @relation("ProgressUpdatePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  withdrawnBy  User?              @relation("ProgressUpdateWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: SetNull)
  photos       ProgressPhoto[]

  @@index([organizationId, projectId, status, updateDate])
  @@map("progress_updates")
  @@schema("construct")
}

// One photo on one update. Exactly one of storagePath/publicImageUrl is
// set (raw-SQL CHECK in the migration — same "raw SQL for what the
// schema DSL can't express" precedent as FollowUp's exactly-one-parent
// constraint): storagePath means a PRIVATE_UPLOAD living in the private
// construct-progress-media bucket, served only via a short-lived signed
// URL issued after re-validating the viewer's access; publicImageUrl
// means staff explicitly chose an ALREADY-public portfolio image — the
// UI must make clear that one was already public, never imply it just
// became private by being attached here.
model ProgressPhoto {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  updateId       String @map("update_id") @db.Uuid

  storagePath    String? @map("storage_path")
  publicImageUrl String? @map("public_image_url")

  caption   String?
  sortOrder Int     @default(0) @map("sort_order")

  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size")
  width    Int?
  height   Int?

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  update       ProgressUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("ProgressPhotoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, updateId, sortOrder])
  @@map("progress_photos")
  @@schema("construct")
}

// One immutable, self-contained snapshot per published/republished
// version of the project summary + milestones — exactly the
// ProposalRevision pattern (see its own schema comment). The public
// page and the "what the customer currently sees" dashboard view both
// read ONLY the latest snapshot's `snapshot` Json, never a live join —
// so an Editor's unapproved edit to the working-copy ProgressProject or
// a ProgressMilestone can never leak until an Owner/Admin explicitly
// publishes again. Published ProgressUpdates are deliberately NOT
// embedded here — they're individually published/withdrawn/editable in
// place and read live (see construct-progress-public.service.ts) since
// unlike the summary/milestones they don't need frozen point-in-time
// snapshotting to satisfy the spec's publication model.
model ProgressSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  snapshot       Json
  publishedAt    DateTime @default(now()) @map("published_at")
  publishedById  String?  @map("published_by_id") @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      ProgressProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publishedBy  User?           @relation("ProgressSnapshotPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([projectId, revisionNumber])
  @@index([organizationId, projectId])
  @@map("progress_snapshots")
  @@schema("construct")
}

// --- Follow-up reminders -----------------------------------------------
// An internal task attached to exactly one parent (an enquiry or a
// proposal) reminding staff of the next action to take on it. Purely
// in-app — no email/SMS/push/browser-push is ever sent (see the
// Follow-ups dashboard's own help text and lib/actions/construct-followup.actions.ts).
// "Overdue" is never stored: it's derived at read time from
// status = OPEN and dueAt in the past, evaluated in the organization's
// own timezone (Organization.timezone), never the server's local time —
// see lib/followups/timezone.ts.
//
// Plan eligibility is inherited from the parent, not a new entitlement
// (see lib/services/construct-followup.service.ts's
// assertFollowUpSchedulingAllowed for the exact mapping):
//   - An enquiry follow-up follows enquiries' own rule: no plan gating
//     at all (enquiries themselves aren't entitlement-gated — see
//     construct-message.actions.ts), only role.
//   - A proposal follow-up follows PROJECT_PROPOSALS, the same
//     entitlement proposal create/edit/publish already enforce — but
//     only when *scheduling new due work* (create, or changing dueAt on
//     an existing one). Completing or cancelling an existing follow-up
//     is never entitlement-gated, so losing the entitlement can never
//     strand a reminder no one is able to close out.
enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED

  @@schema("construct")
}

model FollowUp {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  // Exactly one of enquiryId/proposalId is set — enforced by a raw-SQL
  // CHECK constraint in the migration (Prisma's schema DSL has no
  // XOR/CHECK support, same "raw SQL for what the DSL can't express"
  // precedent as the proposals migration's partial unique index) and
  // re-checked in every server action regardless.
  enquiryId  String? @map("enquiry_id") @db.Uuid
  proposalId String? @map("proposal_id") @db.Uuid

  title String
  note  String?
  dueAt DateTime @map("due_at")

  // Nullable, and SetNull on the referenced user's removal — so a
  // follow-up whose assignee is later removed from the workspace (or
  // demoted to Viewer) survives rather than being deleted; the service
  // layer surfaces assigneeId === null (or an assignee who's no longer
  // ACTIVE/non-VIEWER) as "requires reassignment" instead of silently
  // treating it as assigned. See getEligibleAssignees() and
  // isAssigneeEligible() in construct-followup.service.ts.
  assigneeId String? @map("assignee_id") @db.Uuid

  status FollowUpStatus @default(OPEN)

  // SetNull (not a hard requirement of "always has a creator") to match
  // every other actor reference in this schema (Proposal.createdById,
  // AuditLog.actorUserId) — a user row is never expected to be hard
  // deleted in normal operation, but if it ever is, follow-up history
  // must survive per this feature's "do not delete follow-up history"
  // requirement.
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  completedAt   DateTime? @map("completed_at")
  completedById String?   @map("completed_by_id") @db.Uuid
  outcomeNote   String?   @map("outcome_note")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiry      ContactMessage? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  proposal     Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  assignee     User?           @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy  User?           @relation("FollowUpCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, enquiryId])
  @@index([organizationId, proposalId])
  @@index([organizationId, assigneeId, status, dueAt])
  @@map("follow_ups")
  @@schema("construct")
}
