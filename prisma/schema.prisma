generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             Int              @id @default(autoincrement())
  slug           String
  companyId      Int              @default(0)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  category       String
  status         String
  client         String
  location       String
  year           Int
  duration       String
  budget         String
  area           String
  coverImage     String?
  description    String
  featured       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  gallery        ProjectGallery[]
  highlights     Highlight[]
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?

  @@unique([companyId, slug])
  @@index([companyId])
}

model Highlight {
  id   Int    @id @default(autoincrement())
  text String

  projectId     Int
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId     Int     @default(0)
  tenantCompany Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ProjectGallery {
  id    Int    @id @default(autoincrement())
  image String

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId Int     @default(0)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model Media {
  id           Int           @id @default(autoincrement())
  fileName     String
  originalName String
  altText      String?
  title        String?
  description  String?
  folder       String?
  mimeType     String
  extension    String
  fileSize     Int
  width        Int?
  height       Int?
  type         MediaType
  url          String
  thumbnailUrl String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  galleryItems GalleryItem[]
  companyId    Int           @default(0)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Gallery {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String
  description String?
  coverImage  String?
  featured    Boolean       @default(false)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       GalleryItem[]
  companyId   Int           @default(0)
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
}

model GalleryItem {
  id        Int      @id @default(autoincrement())
  galleryId Int
  mediaId   Int
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id])
  companyId Int     @default(0)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@index([companyId])
}

model Company {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  otp         String        @default("000000")
  adminUserId Int?          @unique
  adminUser   User?         @relation("CompanyAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users            User[]
  projects         Project[]
  highlights       Highlight[]
  projectGalleries ProjectGallery[]
  media            Media[]
  galleries        Gallery[]
  galleryItems     GalleryItem[]
  settings         Settings[]
  services         Service[]
  teamMembers      TeamMember[]
  clients          Client[]
  testimonials     Testimonial[]
  faqs             FAQ[]
  messages         Message[]
  seoSettings      SeoSettings[]
  seoPages         SeoPage[]
  auditLogs        AuditLog[]
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String
  passwordHash String
  role         UserRole  @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  companyId    Int       @default(0)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adminOf      Company?  @relation("CompanyAdmin")

  @@unique([companyId, email])
  @@index([companyId])
}

enum UserRole {
  ADMIN
}

model Settings {
  id Int @id @default(autoincrement())

  // Company
  companyName String
  tagline     String
  description String

  logo String?

  phone   String
  email   String
  website String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  country      String
  postalCode   String?

  // Social
  facebook  String?
  instagram String?
  linkedin  String?
  youtube   String?
  twitter   String?

  // Homepage
  heroTitle    String
  heroSubtitle String

  ctaTitle      String
  ctaSubtitle   String
  ctaButtonText String

  // Statistics
  projectsCompleted Int @default(0)
  clientsServed     Int @default(0)
  yearsExperience   Int @default(0)
  employees         Int @default(0)

  // Default SEO
  seoTitle       String
  seoDescription String
  seoKeywords    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Hero
  heroImage String?

  // CTA
  ctaButtonLink String

  // Contact
  whatsApp      String?
  googleMapsUrl String?

  // Branding
  favicon String?

  // About Page

  aboutTitle    String?
  aboutSubtitle String?
  aboutStory    String?

  missionTitle       String?
  missionDescription String?

  visionTitle       String?
  visionDescription String?

  aboutImage String?
  companyId  Int     @unique @default(0)
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int      @default(0)

  @@index([companyId])
}

model Service {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String
  shortDescription String
  description      String
  image            String?
  icon             String?
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  canonicalUrl     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  companyId        Int      @default(0)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
}

model TeamMember {
  id Int @id @default(autoincrement())

  name String
  slug String

  designation String
  shortBio    String

  photo String

  email String?
  phone String?

  linkedin  String?
  instagram String?
  twitter   String?

  displayOrder   Int     @default(0)
  showOnHomepage Boolean @default(true)
  isActive       Boolean @default(true)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId Int      @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
}

model Client {
  id   Int    @id @default(autoincrement())
  name String
  slug String

  logo    String?
  website String?

  category    String?
  description String?

  displayOrder Int @default(0)

  featured Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId Int      @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
}

model Testimonial {
  id Int @id @default(autoincrement())

  clientName  String
  company     String?
  designation String?

  photo String?

  rating Int @default(5)

  testimonial String

  projectName String?

  featured Boolean @default(false)
  active   Boolean @default(true)

  displayOrder Int @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  companyId     Int      @default(0)
  tenantCompany Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FAQ {
  id Int @id @default(autoincrement())

  question String
  answer   String

  category String?

  displayOrder Int @default(0)

  featured Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId Int      @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Message {
  id              Int      @id @default(autoincrement())
  name            String
  email           String
  phone           String?
  subject         String?
  message         String
  projectInterest String?
  isRead          Boolean  @default(false)
  isReplied       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  companyId       Int      @default(0)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SeoSettings {
  id Int @id @default(autoincrement())

  siteName String

  defaultTitle       String
  defaultDescription String

  defaultKeywords String?

  siteUrl String

  defaultOgImage String?

  favicon String?

  appleTouchIcon String?

  twitterHandle String?

  facebookAppId String?

  robotsIndex  Boolean @default(true)
  robotsFollow Boolean @default(true)

  googleVerification String?

  bingVerification String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId Int      @unique @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SeoPage {
  id Int @id @default(autoincrement())

  pageKey String

  pageName String

  title String

  description String

  keywords String?

  canonicalUrl String?

  ogTitle String?

  ogDescription String?

  ogImage String?

  robotsIndex Boolean @default(true)

  robotsFollow Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  companyId Int      @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, pageKey])
  @@index([companyId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  module    String
  action    String
  recordId  String?
  title     String
  details   String?
  createdAt DateTime @default(now())
  companyId Int      @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([module])
  @@index([createdAt])
  @@index([companyId])
}
