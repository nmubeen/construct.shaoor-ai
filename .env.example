# Temporary SQLite runtime; retained until the PostgreSQL application cutover.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"

# Shared Shaoor AI Tech Supabase project. Configure during the cutover phase.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
CONSTRUCT_DATABASE_URL="postgresql://USER:PASSWORD@POOLER:6543/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="server-only-never-expose-to-browser"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay (Settings -> API Keys). Test-mode keys work immediately after
# account creation, before KYC/live activation completes. Each paid plan
# (construct.plans.razorpay_plan_id_monthly/annual) also needs a
# corresponding Plan created in the Razorpay dashboard before self-serve
# checkout works for it — see app/api/razorpay/subscription's guard.
RAZORPAY_KEY_ID="rzp_test_..."
# The key id is also needed client-side (Checkout.js), hence the
# NEXT_PUBLIC_ copy — this one is safe to expose, unlike the secret below.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
# Set once you've created a webhook (Settings -> Webhooks) pointing at
# /api/razorpay/webhook and selected the subscription.* events.
RAZORPAY_WEBHOOK_SECRET="..."

# Shared secret checked against the Authorization header on /api/cron/*
# routes so only Vercel Cron (or you, manually) can trigger them.
CRON_SECRET=""
